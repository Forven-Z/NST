<view class="nav-bar" style="background: {{bgColor}}; padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar-inner" style="height: {{navBarHeight}}px; color: {{textColor}};">
    <view wx:if="{{showBack}}" class="nav-back" bindtap="onBack" hover-class="nav-back-hover">
      <text class="nav-back-icon">‹</text>
      <text class="nav-back-text">返回</text>
    </view>
    <text class="nav-title">{{title}}</text>
  </view>
</view>
<view class="nav-bar-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>
