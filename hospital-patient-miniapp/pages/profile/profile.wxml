<view class="container">
  <view class="card">
    <view class="card-title">个人档案</view>
    <view class="muted">病历号：{{medicalRecordNo || '—'}}</view>
  </view>

  <view class="card" wx:if="{{!loading}}">
    <view class="field">
      <view class="label">姓名</view>
      <input class="input" data-field="realName" value="{{form.realName}}" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="label">性别</view>
      <picker mode="selector" range="{{genderOptions}}" value="{{form.gender}}" bindchange="onGenderChange">
        <view class="picker">{{genderOptions[form.gender] || '男'}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">手机号</view>
      <input class="input" type="number" data-field="phone" value="{{form.phone}}" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="label">身份证号</view>
      <input class="input" data-field="idCard" value="{{form.idCard}}" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="label">地址</view>
      <input class="input" data-field="address" value="{{form.address}}" bindinput="onInput" />
    </view>
    <button class="btn-primary" loading="{{saving}}" bindtap="onSave">保存档案</button>
    <button class="btn-ghost logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
