<view class="container messages-page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无消息</view>
  <block wx:else>
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="msg-card {{item.read ? '' : 'unread'}}"
      data-link="{{item.link}}"
      bindtap="onTap"
    >
      <view class="msg-head">
        <text class="msg-title">{{item.title}}</text>
        <text class="msg-time">{{item.timeLabel}}</text>
      </view>
      <view class="msg-body">{{item.content}}</view>
      <view wx:if="{{item.link}}" class="msg-link">点击查看 ›</view>
    </view>
  </block>
</view>
