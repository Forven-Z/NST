.messages-page {
  padding-top: 16rpx;
}

.msg-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.msg-card.unread {
  border-left: 6rpx solid #1677ff;
}

.msg-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.msg-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.msg-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.msg-body {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.msg-link {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #1677ff;
}
