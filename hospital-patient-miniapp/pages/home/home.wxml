<view class="home-page">
  <view class="welcome card">
    <view class="welcome-row row-between">
      <view class="welcome-left">
        <view class="welcome-title">您好，{{currentAccountName}}</view>
        <view class="welcome-sub muted">病历号 {{currentMedicalRecordNo}}</view>
      </view>
      <view wx:if="{{loggedIn}}" class="member-switch" bindtap="onSwitchAccount">
        <text class="member-switch-label">就诊账户</text>
        <text class="member-switch-name">切换</text>
        <text class="member-arrow">▼</text>
      </view>
      <button wx:else class="welcome-login-btn" size="mini" bindtap="onGoLogin">登录</button>
    </view>
  </view>

  <view class="trip card" wx:if="{{loggedIn && trip}}">
    <view class="trip-head row-between">
      <view class="trip-label">当前就医</view>
      <view class="trip-tag">{{trip.stateLabel}}</view>
    </view>
    <view class="trip-main">{{trip.deptName}} · {{trip.doctorName}}</view>
    <view class="trip-sub muted">{{trip.levelName}} · {{trip.workDate}} {{trip.noonLabel}}</view>
    <view class="trip-sub-hint" wx:if="{{trip.subHint}}">{{trip.subHint}}</view>
    <button class="btn-primary trip-btn" bindtap="onTripAction">{{trip.actionText}}</button>
  </view>

  <view class="trip card empty-trip" wx:elif="{{loggedIn}}">
    <view class="trip-label">当前就医</view>
    <view class="muted">当前账户暂无进行中的挂号</view>
    <button class="btn-primary trip-btn" bindtap="goRegister">去挂号</button>
  </view>

  <view class="trip card guest-trip" wx:else>
    <view class="trip-label">欢迎使用</view>
    <view class="muted">登录病人账户后可挂号、缴费；可添加并切换多个就诊人</view>
    <button class="btn-primary trip-btn" bindtap="onGoLogin">登录病人账户</button>
  </view>

  <view class="service-panel">
    <view class="tab-bar">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{activeTab === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTabChange"
      >
        {{item.label}}
      </view>
    </view>
    <view class="service-grid {{gridColClass}}">
      <view
        wx:for="{{gridItems}}"
        wx:key="id"
        class="service-cell"
        data-id="{{item.id}}"
        bindtap="onGridTap"
      >
        <view class="service-icon">{{item.icon}}</view>
        <view class="service-name">{{item.name}}</view>
        <view class="service-soon" wx:if="{{item.comingSoon}}">敬请期待</view>
      </view>
    </view>
  </view>

  <view class="tip card">
    <view class="tip-title">就医提示</view>
    <view class="tip-text muted">当前登录的是病人账户。切换就诊账户后再挂号，费用与报告均归属该账户。为家属代办请先添加家属并切换登录。支付时将绑定微信用于收银。</view>
  </view>
</view>
