.home-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.welcome {
  background: linear-gradient(135deg, #1677ff, #4096ff);
  color: #ffffff;
  border: none;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.welcome-sub {
  color: rgba(255, 255, 255, 0.88) !important;
  font-size: 24rpx;
}

.welcome-login-btn {
  background: rgba(255, 255, 255, 0.95) !important;
  color: #1677ff !important;
  border: none;
  font-weight: 600;
}

.guest-trip .muted {
  line-height: 1.6;
  margin: 12rpx 0 20rpx;
}

.welcome-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.welcome-left {
  flex: 1;
  min-width: 0;
}

.member-switch {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  text-align: center;
  max-width: 240rpx;
}

.member-switch-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.85;
}

.member-switch-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-arrow {
  font-size: 20rpx;
  margin-left: 4rpx;
}

.trip-sub-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #ea580c;
}

.trip-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.trip-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #e6f4ff;
  color: #1677ff;
}

.trip-main {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.trip-sub {
  font-size: 24rpx;
}

.trip-pending {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ea580c;
}

.trip-btn {
  margin-top: 24rpx;
  width: 100%;
}

.empty-trip .muted {
  margin: 8rpx 0 0;
  font-size: 26rpx;
}

.service-panel {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.05);
}

.tab-bar {
  display: flex;
  flex-direction: row;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #64748b;
  position: relative;
}

.tab-item.active {
  color: #1677ff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  margin-left: -24rpx;
  background: #1677ff;
  border-radius: 3rpx;
}

.service-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 16rpx 8rpx 24rpx;
}

.service-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  box-sizing: border-box;
}

.service-grid--five .service-cell {
  width: 20%;
}

.service-grid--few .service-cell {
  width: 33.33%;
}

.service-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8f3ff;
  color: #1677ff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.service-name {
  font-size: 22rpx;
  color: #334155;
  text-align: center;
  line-height: 1.35;
}

.service-soon {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tip-text {
  font-size: 24rpx;
  line-height: 1.6;
}
