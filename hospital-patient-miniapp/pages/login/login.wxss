.login-page {
  min-height: 100vh;
  padding: 80rpx 40rpx 40rpx;
  background: linear-gradient(180deg, #1677ff 0%, #1677ff 280rpx, #f5f7fa 280rpx);
  box-sizing: border-box;
}

.hero {
  text-align: center;
  color: #fff;
  margin-bottom: 48rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 40rpx;
  font-weight: 700;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(15, 23, 42, 0.08);
}

.label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 16rpx;
}

.input {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.login-btn {
  margin-top: 8rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}
