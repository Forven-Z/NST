.login-page {
  min-height: 100vh;
  padding: 0 32rpx 40rpx;
  background: linear-gradient(180deg, #1677ff 0%, #1677ff 320rpx, #f5f7fa 320rpx);
  box-sizing: border-box;
}

.hero {
  text-align: center;
  color: #fff;
  margin-bottom: 32rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 40rpx;
  font-weight: 700;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.banner {
  background: #fef3c7;
  color: #92400e;
  font-size: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(15, 23, 42, 0.08);
}

.hint {
  font-size: 24rpx;
  color: #64748b;
  margin: -8rpx 0 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #334155;
  margin-bottom: 10rpx;
}

.label.required::before {
  content: '*';
  color: #ef4444;
  margin-right: 4rpx;
}

.input,
.picker {
  background: #f8fafc;
  padding: 22rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.login-btn {
  margin-top: 8rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.link-row {
  margin-top: 16rpx;
  text-align: center;
}

.link {
  color: #2563eb;
  font-size: 26rpx;
}
