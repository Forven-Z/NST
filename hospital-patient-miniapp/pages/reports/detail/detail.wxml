<view class="detail-page">
  <view wx:if="{{loading}}" class="empty card">加载中…</view>
  <view wx:elif="{{!detail}}" class="empty card">报告不存在</view>
  <view wx:else>
    <view class="card head-card">
      <view class="row-between">
        <text class="title">{{detail.reportName}}</text>
        <text class="tag">{{detail.typeLabel}}</text>
      </view>
      <view class="muted meta">{{detail.timeLabel}} {{detail.reportTime}}</view>
    </view>

    <view class="card" wx:if="{{detail.purpose || detail.bodyPart}}">
      <view class="section-title">{{detail.applySectionTitle}}</view>
      <view wx:if="{{detail.purpose}}" class="line">{{detail.purposeLabel}}：{{detail.purpose}}</view>
      <view wx:if="{{detail.bodyPart}}" class="line">部位：{{detail.bodyPart}}</view>
    </view>

    <view class="card">
      <view class="section-title">{{detail.contentSectionTitle}}</view>
      <view class="result-text">{{detail.resultText || '暂无详细内容'}}</view>
    </view>
  </view>
</view>
