<view class="reports-page">
  <view class="member-bar card row-between" wx:if="{{loggedIn}}" bindtap="onSwitchMember">
    <view>
      <view class="member-label muted">当前就诊账户</view>
      <view class="member-name">{{activeMemberName}}</view>
    </view>
    <text class="member-link">切换 ›</text>
  </view>

  <view class="tab-row card" wx:if="{{loggedIn}}">
    <view class="tab-chip {{tab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="onTab">全部</view>
    <view class="tab-chip {{tab === 'lab' ? 'active' : ''}}" data-tab="lab" bindtap="onTab">检验</view>
    <view class="tab-chip {{tab === 'exam' ? 'active' : ''}}" data-tab="exam" bindtap="onTab">检查</view>
    <view class="tab-chip {{tab === 'disposal' ? 'active' : ''}}" data-tab="disposal" bindtap="onTab">处置</view>
  </view>

  <view wx:if="{{!loggedIn}}" class="empty card guest-empty">
    <view class="empty-title">登录后查看报告</view>
    <view class="muted">检验、检查、处置结果将在医生出报告后显示</view>
    <button class="btn-primary guest-login-btn" bindtap="onGoLogin">登录病人账户</button>
  </view>

  <view wx:elif="{{loading}}" class="empty card">加载中…</view>
  <view wx:elif="{{loadError}}" class="empty card">
    <view class="empty-title">加载失败</view>
    <button class="btn-primary" size="mini" bindtap="onRetry">重试</button>
  </view>
  <view wx:elif="{{!list.length}}" class="empty card">
    <view class="empty-title">{{pendingCount > 0 ? '报告尚未出具' : '暂无报告'}}</view>
    <view class="muted">{{emptyHint}}</view>
  </view>
  <view wx:else class="list-wrap">
    <block wx:for="{{groups}}" wx:key="dateLabel" wx:for-item="group">
      <view class="date-group-label">{{group.dateLabel}}</view>
      <view
        wx:for="{{group.items}}"
        wx:for-item="item"
        wx:key="id"
        class="card report-row"
        data-item="{{item}}"
        bindtap="onDetail"
      >
        <view class="row-between">
          <text class="report-name">{{item.reportName}}</text>
          <view class="tag-wrap">
            <text class="snap-badge" wx:if="{{item.hasSnapshots}}">含影像</text>
            <text class="tag tag-{{item.type}}">{{item.typeLabel}}</text>
          </view>
        </view>
        <view class="muted meta">{{item.patientName}} · {{item.reportTime}}</view>
        <view class="summary">{{item.summary}}</view>
        <view class="row-link">查看详情 ›</view>
      </view>
    </block>
  </view>
</view>
