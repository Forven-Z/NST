<view class="container">
  <view class="card" wx:if="{{!record}}">
    <view class="card-title">电子病历</view>
    <view class="muted">从「挂号记录」进入可自动带入单号；或手动输入</view>
    <input class="input" placeholder="挂号单号 registerId" value="{{registerId}}" bindinput="onRegisterInput" />
    <button class="btn-primary" loading="{{loading}}" bindtap="onQuery">查询</button>
  </view>

  <view class="card" wx:if="{{record}}">
    <view class="card-title">病历 · 单号 {{registerId}}</view>
    <view class="field"><text class="k">主诉</text>{{record.readme || '—'}}</view>
    <view class="field"><text class="k">诊断</text>{{record.diagnosis || '—'}}</view>
    <view class="field"><text class="k">处理</text>{{record.cure || '—'}}</view>
  </view>
</view>
