.query-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.query-row .input {
  flex: 1;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.query-btn {
  min-width: 160rpx;
  padding: 0 24rpx !important;
  line-height: 80rpx !important;
  height: 80rpx !important;
}

.record-block {
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 26rpx;
  color: #1677ff;
  font-weight: 600;
  margin-bottom: 8rpx;
}
