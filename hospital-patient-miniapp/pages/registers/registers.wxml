<view class="container">
  <view class="filter-row card">
    <text class="filter {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onFilter">全部</text>
    <text class="filter {{filter === '0' ? 'active' : ''}}" data-filter="0" bindtap="onFilter">待支付</text>
    <text class="filter {{filter === '1' ? 'active' : ''}}" data-filter="1" bindtap="onFilter">已挂号</text>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{!list.length}}" class="empty">暂无挂号记录</view>
  <view wx:else>
    <view class="card" wx:for="{{list}}" wx:key="registerId">
      <view class="row-between">
        <view class="doctor-name">{{item.deptName}} · {{item.doctorName}}</view>
        <view class="tag">{{item.stateLabel}}</view>
      </view>
      <view class="muted">{{item.patientName}} · {{item.registLevelName}}</view>
      <view class="muted">{{item.workDate}} {{item.noonLabel}} · ¥{{item.registFee}}</view>
      <view class="actions">
        <button wx:if="{{item.visitState === 0}}" size="mini" class="btn-primary" bindtap="goPay">去支付</button>
        <button wx:if="{{item.canQueue}}" size="mini" bindtap="goQueue" data-id="{{item.registerId}}">排队情况</button>
        <button wx:if="{{item.canCancel}}" size="mini" bindtap="onCancel" data-id="{{item.registerId}}">退号</button>
        <button wx:if="{{item.visitState >= 1}}" size="mini" bindtap="goOrders" data-id="{{item.registerId}}">医嘱进度</button>
        <button wx:if="{{item.visitState >= 2}}" size="mini" bindtap="goRecord" data-id="{{item.registerId}}">病历</button>
      </view>
    </view>
  </view>
</view>
