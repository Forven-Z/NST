.queue-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.queue-num {
  font-size: 96rpx;
  font-weight: 700;
  color: #1677ff;
  line-height: 1.2;
}

.queue-label {
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 28rpx;
  color: #334155;
  margin-bottom: 24rpx;
}

.divider {
  height: 1rpx;
  background: #e2e8f0;
  margin: 24rpx 0;
}

.tip {
  margin-top: 24rpx;
}
