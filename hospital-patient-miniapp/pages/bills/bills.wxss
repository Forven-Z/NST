.page-tabs {
  display: flex;
  flex-direction: row;
  padding: 8rpx;
  margin-bottom: 16rpx;
}

.page-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #64748b;
  border-radius: 12rpx;
}

.page-tab.active {
  background: #1677ff;
  color: #fff;
  font-weight: 600;
}

.paid-item {
  margin-bottom: 16rpx;
}

.link {
  color: #1677ff;
  font-size: 26rpx;
}

.bill-item.selected {
  border: 2rpx solid #1677ff;
}

.bill-title {
  font-size: 30rpx;
  font-weight: 600;
}

.biz-type {
  margin-top: 8rpx;
}

.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.08);
}

.pay-total {
  font-size: 28rpx;
  font-weight: 600;
}

.pay-btn {
  min-width: 240rpx;
}

.btn-wechat {
  background: #07c160 !important;
  color: #fff !important;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.wechat-icon {
  display: inline-flex;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.pay-note {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.bill-check-wrap {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.bill-check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 50%;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.bill-check.checked {
  border-color: #1677ff;
  background: #1677ff;
}

.bill-check.checked::after {
  content: '';
  display: block;
  width: 12rpx;
  height: 20rpx;
  border: solid #fff;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
  margin: 4rpx auto 0;
}

.line-toggle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #1677ff;
}

.line-items {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.line-row {
  padding: 8rpx 0;
  font-size: 24rpx;
}

.line-name {
  font-weight: 500;
  color: #334155;
}

.line-amount {
  color: #1677ff;
  margin-top: 4rpx;
}

.guest-empty {
  text-align: center;
  padding: 48rpx 32rpx;
}

.guest-empty .guest-login-btn {
  margin-top: 24rpx;
}

.container {
  padding-bottom: 180rpx;
}
