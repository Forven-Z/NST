<view class="container">
  <view class="card">
    <view class="row-between">
      <view class="card-title">待缴费用</view>
      <view class="link" bindtap="onSelectAll">
        {{selectedIds.length === bills.length && bills.length ? '取消全选' : '全选'}}
      </view>
    </view>
    <view class="muted">开发期模拟支付，无需真实微信支付</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{bills.length === 0}}" class="empty">暂无待缴账单</view>

  <view wx:else>
    <view
      class="card bill-item {{item.checked ? 'selected' : ''}}"
      wx:for="{{bills}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onToggleBill"
    >
      <view class="row-between">
        <view>
          <view class="bill-title">{{item.billTitle}}</view>
          <view class="muted">{{item.billNo}}</view>
        </view>
        <view class="price">¥{{item.amount}}</view>
      </view>
      <view class="muted biz-type">{{item.bizType}}</view>
    </view>
  </view>

  <view class="pay-bar" wx:if="{{bills.length}}">
    <view>
      <view class="muted">已选 {{selectedIds.length}} 项</view>
      <view class="pay-total">合计 <text class="price">¥{{totalAmount}}</text></view>
    </view>
    <button class="btn-primary pay-btn" loading="{{paying}}" bindtap="onPay">模拟支付</button>
  </view>
</view>
