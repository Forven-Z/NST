.mine-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 48rpx;
}

.profile-header {
  background: linear-gradient(180deg, #1677ff 0%, #4096ff 100%);
  padding: 48rpx 32rpx 56rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #ffffff;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.profile-phone {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 4rpx;
}

.profile-mrn {
  font-size: 22rpx;
  opacity: 0.85;
}

.menu-panel {
  margin: -24rpx 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
  color: #1e293b;
}

.menu-row:last-child {
  border-bottom: none;
}

.arrow {
  color: #94a3b8;
  font-size: 36rpx;
  line-height: 1;
}

.logout {
  margin: 32rpx 24rpx 0;
}

.guest-panel {
  margin: -24rpx 24rpx 0;
  padding: 40rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.guest-hint {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 28rpx;
  display: block;
}

.panel {
  margin: 16rpx 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 32rpx 8rpx;
  color: #334155;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.account-name {
  font-size: 30rpx;
  color: #0f172a;
}

.add-account {
  margin: 16rpx 32rpx 24rpx;
}

.danger {
  color: #ef4444;
  font-size: 24rpx;
}
