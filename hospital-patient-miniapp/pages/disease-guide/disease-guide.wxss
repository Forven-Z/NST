.triage-page {
  min-height: 100vh;
  padding: 24rpx 28rpx 28rpx;
  box-sizing: border-box;
  background: #f5f7fa;
}

.triage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.triage-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.triage-sub {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 24rpx;
}

.reset-btn {
  margin: 0;
  color: #1677ff !important;
  background: #fff !important;
  border: 1rpx solid #dbeafe !important;
  border-radius: 10rpx !important;
}

.chat-panel {
  height: calc(100vh - 310rpx);
  padding: 4rpx 0 16rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  gap: 14rpx;
  margin: 20rpx 0;
}

.from-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
  background: #475569;
  font-size: 22rpx;
  font-weight: 600;
}

.from-user .avatar {
  background: #1677ff;
}

.bubble {
  max-width: 560rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #1f2937;
  line-height: 1.6;
  font-size: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
  word-break: break-word;
}

.from-user .bubble {
  background: #1677ff;
  color: #fff;
}

.typing {
  color: #64748b;
}

.recommend-block,
.emergency-card {
  margin: 24rpx 0;
}

.block-title {
  margin-bottom: 14rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

.recommend-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.recommend-main {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.dept-name {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
}

.reason {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.confidence {
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  color: #047857;
  background: #d1fae5;
  font-size: 22rpx;
  flex-shrink: 0;
}

.next-action {
  margin-top: 18rpx;
  color: #1677ff;
  font-size: 26rpx;
  font-weight: 600;
}

.emergency-card {
  padding: 24rpx;
  border-radius: 16rpx;
  color: #991b1b;
  background: #fee2e2;
}

.quick-row {
  margin-bottom: 16rpx;
}

.quick-inner {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
}

.quick-chip {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #1677ff;
  background: #e6f4ff;
  font-size: 24rpx;
}

.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 22rpx rgba(15, 23, 42, 0.08);
}

.symptom-input {
  min-height: 56rpx;
  max-height: 150rpx;
  flex: 1;
  padding: 12rpx 0;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.5;
}

.send-btn {
  width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  color: #fff !important;
  background: #1677ff !important;
  border-radius: 12rpx !important;
  font-size: 26rpx !important;
}

.safety {
  padding: 16rpx 8rpx 0;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.42);
}

.recommend-modal {
  width: 100%;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 20rpx 20rpx 16rpx 16rpx;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 18rpx 60rpx rgba(15, 23, 42, 0.24);
}

.modal-kicker {
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 600;
}

.modal-title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 38rpx;
  font-weight: 700;
}

.modal-confidence {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  color: #047857;
  background: #d1fae5;
  font-size: 23rpx;
}

.modal-reason {
  margin-top: 22rpx;
  color: #334155;
  font-size: 28rpx;
  line-height: 1.6;
}

.modal-notice {
  margin-top: 18rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.modal-secondary,
.modal-primary {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  border-radius: 12rpx !important;
  font-size: 28rpx !important;
}

.modal-secondary {
  color: #1677ff !important;
  background: #fff !important;
  border: 1rpx solid #bfdbfe !important;
}

.modal-primary {
  color: #fff !important;
  background: #1677ff !important;
}

.triage-disclaimer {
  padding: 16rpx 24rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}
