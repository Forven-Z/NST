.orders-page {

  padding: 24rpx;

  padding-bottom: 48rpx;

}



.summary-card {

  margin-bottom: 24rpx;

}



.summary-title {

  font-size: 32rpx;

  font-weight: 600;

  margin-bottom: 8rpx;

}



.order-row {

  margin-bottom: 20rpx;

}



.item-name {

  font-size: 30rpx;

  font-weight: 500;

  flex: 1;

  margin-right: 16rpx;

}



.tag {

  font-size: 22rpx;

  padding: 4rpx 12rpx;

  border-radius: 8rpx;

  background: #e8f3ff;

  color: #1677ff;

}



.tag-prescription {

  background: #f0fdf4;

  color: #059669;

}



.order-action-btn {

  margin-top: 16rpx;

  background: #1677ff;

  color: #fff;

}



.error-card .empty-title {

  font-size: 30rpx;

  margin-bottom: 8rpx;

}



.retry-btn {

  margin-top: 20rpx;

}



.hint-small {

  font-size: 24rpx;

  margin-top: 8rpx;

}



.empty-title {

  font-size: 30rpx;

  font-weight: 500;

  margin-bottom: 8rpx;

}


