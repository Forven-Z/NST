.banner {
  background: #fef3c7;
  color: #92400e;
  font-size: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.switch-label {
  font-size: 24rpx;
  color: #64748b;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #334155;
  margin-bottom: 10rpx;
}

.label.required::before {
  content: '*';
  color: #ef4444;
  margin-right: 4rpx;
}

.input,
.picker {
  background: #f8fafc;
  padding: 22rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.hint {
  font-size: 24rpx;
  color: #64748b;
  margin: -8rpx 0 24rpx;
}

.submit-btn {
  margin-top: 16rpx;
}
