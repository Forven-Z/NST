<view class="container">
  <view class="card">
    <view class="card-title">添加就诊人</view>
    <view class="form-item">
      <text class="label">姓名</text>
      <input placeholder="真实姓名" data-field="realName" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="label">身份证</text>
      <input placeholder="18位身份证号" data-field="idCard" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input placeholder="选填" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="label">关系</text>
      <picker mode="selector" range="{{relationTypes}}" range-key="label" bindchange="onRelationChange">
        <view class="picker">请选择与本人关系</view>
      </picker>
    </view>
    <button class="btn-primary" loading="{{saving}}" bindtap="onSubmit">保存</button>
  </view>
</view>
