page {
  background: #f5f7fa;
  color: #1f2937;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.btn-primary {
  background: #1677ff !important;
  color: #fff !important;
  border-radius: 12rpx !important;
  font-size: 30rpx !important;
}

.btn-ghost {
  background: #fff !important;
  color: #1677ff !important;
  border: 2rpx solid #1677ff !important;
  border-radius: 12rpx !important;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #9ca3af;
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #e6f4ff;
  color: #1677ff;
}

.price {
  color: #ef4444;
  font-weight: 600;
}
