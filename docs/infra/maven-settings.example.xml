<?xml version="1.0" encoding="UTF-8"?>
<!--
  智慧云脑诊疗平台 — Maven 国内镜像配置（团队模板）
  用法（推荐）：
    1. 复制本文件到：C:\Users\<你的用户名>\.m2\settings.xml
    2. 若 .m2 目录不存在，先新建文件夹
    3. 重新打开 PowerShell，执行 mvn -version / 编译项目
  说明：放在用户目录 .m2 下，不修改 Maven 安装目录，便于升级 Maven 版本
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <!-- 本地仓库（默认即为用户目录\.m2\repository，一般不用改） -->
  <localRepository>${user.home}/.m2/repository</localRepository>

  <mirrors>
    <!-- 阿里云公共仓库：代理 central + 常用第三方 -->
    <mirror>
      <id>aliyun-public</id>
      <mirrorOf>*</mirrorOf>
      <name>Aliyun Public Repository</name>
      <url>https://maven.aliyun.com/repository/public</url>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>jdk-17</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      </properties>
    </profile>
  </profiles>

</settings>
